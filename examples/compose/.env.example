# Copy to .env and fill in. See the README for every option.

# The single domain this instance issues certificates for. Its public DNS zone
# holds only NS and SOA records; the real host records live in internal DNS.
ACME_PROXY_INTERNAL_DOMAIN=example.biz

# Optional: comma-separated Wildcard Bases (*.apps.example.biz becomes allowed,
# proven by HTTP-01 against the host apps.example.biz).
ACME_PROXY_WILDCARD_BASES=

# Internal DNS server used to resolve Requesters for HTTP-01 checks (host:port).
# Leave empty if the Docker host's resolver already answers for the Internal Domain.
ACME_PROXY_CHALLENGE_RESOLVER=10.0.0.53:53

# Public CA. Start with Let's Encrypt staging; switch to production
# (https://acme-v02.api.letsencrypt.org/directory) once everything works.
ACME_PROXY_PUBLIC_CA_DIRECTORY=https://acme-staging-v02.api.letsencrypt.org/directory
ACME_PROXY_PUBLIC_CONTACT=ops@example.com
ACME_PROXY_PUBLIC_AGREE_TOS=true

# DNS Provider of the Internal Domain's public zone, plus the credentials lego
# expects for it (https://go-acme.github.io/lego/dns/).
ACME_PROXY_DNS_PROVIDER=cloudflare
CLOUDFLARE_DNS_API_TOKEN=change-me
